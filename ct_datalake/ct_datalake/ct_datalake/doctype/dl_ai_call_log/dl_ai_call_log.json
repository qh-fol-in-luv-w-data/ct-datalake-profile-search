{
  "actions": [],
  "autoname": "format:DL-AI-{YYYY}{MM}{DD}-{######}",
  "doctype": "DocType",
  "engine": "InnoDB",
  "field_order": [
    "session", "action_log", "user", "timestamp",
    "call_type", "ai_model", "attempt_number",
    "section_tokens", "prompt_tokens", "completion_tokens", "total_tokens",
    "section_result", "duration_seconds", "status", "error_code", "error_message"
  ],
  "fields": [
    {
      "fieldname": "session",
      "fieldtype": "Link",
      "options": "DL Session",
      "label": "Session",
      "in_list_view": 1,
      "reqd": 1,
      "read_only": 1
    },
    {
      "fieldname": "action_log",
      "fieldtype": "Link",
      "options": "DL Action Log",
      "label": "Action Log",
      "read_only": 1
    },
    {
      "fieldname": "user",
      "fieldtype": "Link",
      "options": "User",
      "label": "User",
      "read_only": 1
    },
    {
      "fieldname": "timestamp",
      "fieldtype": "Datetime",
      "label": "Timestamp",
      "in_list_view": 1,
      "read_only": 1
    },
    {
      "fieldname": "call_type",
      "fieldtype": "Data",
      "label": "Call Type",
      "in_list_view": 1,
      "read_only": 1,
      "description": "VD: semantic_search_llm, jd_match, g600_analyze, draft_document"
    },
    {
      "fieldname": "ai_model",
      "fieldtype": "Data",
      "label": "AI Model",
      "in_list_view": 1,
      "read_only": 1
    },
    {
      "fieldname": "attempt_number",
      "fieldtype": "Int",
      "label": "Attempt #",
      "default": "1",
      "read_only": 1
    },
    {
      "fieldname": "section_tokens",
      "fieldtype": "Section Break",
      "label": "Token Usage"
    },
    {
      "fieldname": "prompt_tokens",
      "fieldtype": "Int",
      "label": "Prompt Tokens",
      "default": "0",
      "read_only": 1
    },
    {
      "fieldname": "completion_tokens",
      "fieldtype": "Int",
      "label": "Completion Tokens",
      "default": "0",
      "read_only": 1
    },
    {
      "fieldname": "total_tokens",
      "fieldtype": "Int",
      "label": "Total Tokens",
      "in_list_view": 1,
      "default": "0",
      "read_only": 1
    },
    {
      "fieldname": "section_result",
      "fieldtype": "Section Break",
      "label": "Result"
    },
    {
      "fieldname": "duration_seconds",
      "fieldtype": "Float",
      "label": "Duration (seconds)",
      "read_only": 1
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "success\nfailed\nrate_limited\ncached",
      "in_list_view": 1,
      "read_only": 1
    },
    {
      "fieldname": "error_code",
      "fieldtype": "Data",
      "label": "Error Code",
      "read_only": 1
    },
    {
      "fieldname": "error_message",
      "fieldtype": "Small Text",
      "label": "Error Message",
      "read_only": 1
    }
  ],
  "links": [],
  "module": "CT DataLake",
  "name": "DL AI Call Log",
  "naming_rule": "Expression (old style)",
  "owner": "Administrator",
  "permissions": [
    {
      "create": 1, "delete": 1, "export": 1,
      "read": 1, "report": 1,
      "role": "System Manager", "write": 1
    }
  ],
  "sort_field": "timestamp",
  "sort_order": "DESC",
  "track_changes": 0
}
